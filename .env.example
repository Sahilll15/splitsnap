GROQ_API_KEY=
# More Groq keys, comma or newline separated. Tried in order after GROQ_API_KEY before falling back to OpenAI.
GROQ_API_KEYS=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Fallback when Groq is rate limited or down, and the only provider when GROQ_API_KEY is empty.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# RATE_LIMIT_SCAN=4
# RATE_LIMIT_WINDOW_MS=3600000
# Shared rate limit store (Upstash Redis). Without these, counts stay in memory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
